---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostRow from '../components/PostRow.astro';
import Sidebar from '../components/Sidebar.astro';
import { getPublishedPosts, SITE } from '../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout active="home" wide>
  <div class="home-only">
    <section class="home-intro">
      <h1>{SITE.tagline}</h1>
      <p class="home-bio">
        像侦探一样追踪出海商业里的冷门信号：跨境电商、独立站、AI
        调研、新产品增长。这里持续公开我的研究过程，从发现问题、整理线索到形成判断，靠近那些还没被充分看见的机会。
      </p>
      <p class="home-contact">
        想交流或聊合作 →
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </section>

    <div class="home-columns">
      <section class="home-posts" id="articles">
        <h2>文章</h2>
        {
          posts.length === 0 ? (
            <p class="empty">还没有文章</p>
          ) : (
            <ul class="home-list">
              {posts.map((post) => (
                <PostRow post={post} />
              ))}
            </ul>
          )
        }
      </section>

      <Sidebar />
    </div>
  </div>
</BaseLayout>
