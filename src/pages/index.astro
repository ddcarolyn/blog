---
import BaseLayout from '../layouts/BaseLayout.astro';
import LetterBand from '../components/LetterBand.astro';
import IndexGrid from '../components/IndexGrid.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout active="home" wide>
  <div class="home">
    <LetterBand img="/images/letter/band-a.webp" tone="a" />
    {posts.length === 0 ? <p class="empty">还没有文章</p> : <IndexGrid posts={posts} />}
  </div>
</BaseLayout>
