---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import FeaturedCard from '../components/FeaturedCard.astro';
import CategorySection from '../components/CategorySection.astro';
import { getPublishedPosts, postsByCategory, SITE } from '../lib/posts';
import { LETTER_INTRO } from '../lib/letter';

const posts = await getPublishedPosts();
const [hero, ...rest] = posts;
const side = rest.slice(0, 3);
const groups = postsByCategory(posts);
---

<BaseLayout active="home" wide>
  <div class="home">
    <section class="home-intro">
      <h1>{SITE.tagline}</h1>
      <div class="home-banner">
        <img src="/images/home-banner.webp" srcset="/images/home-banner-768.webp 768w, /images/home-banner.webp 1536w" sizes="(max-width: 600px) 100vw, 1048px" alt="" width="1536" height="720" fetchpriority="high" decoding="async" />
        <div class="home-banner-text">
          {LETTER_INTRO.map((line, i) => <p class={i === 0 ? 'lead' : undefined}>{line}</p>)}
        </div>
      </div>
      <p class="home-contact">
        想交流或聊合作 →
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </section>

    <CategoryTabs active="all" />

    {
      posts.length === 0 ? (
        <p class="empty">还没有文章</p>
      ) : (
        <>
          <FeaturedCard hero={hero} side={side} />
          <div id="columns" class="home-columns-stack">
            {groups.map((g) => (
              <CategorySection category={g.category} posts={g.posts} />
            ))}
          </div>
        </>
      )
    }
  </div>
</BaseLayout>
