  'mechanical_keyboards': '机械键盘',
  'gaming_mice': '游戏鼠标',
  'keychron_official': 'Keychron 官号',
  'competitors': '竞品',
  'esports_cs2': 'CS2 电竞'
};

const legacyMatches = digest.domains.esports_cs2.filter(item => 
  item.author_username === 'legacyggbr' || item.topic.includes('Legacy')
);
---

<BaseLayout title="Keychron X 情报台" wide>
  <link rel="stylesheet" href="/keychron-dashboard.css" />
  
  <div class="keychron-dashboard">
    <!-- Sticky Sidebar Navigation -->
    <aside class="dashboard-sidebar">
      <div class="sidebar-sticky">
        <h3 class="sidebar-title">筛选目录</h3>
        <nav class="domain-nav">
          <a href="#overview" class="domain-nav-item active">总览</a>
          <a href="#ai-summary" class="domain-nav-item">AI 阅读摘要</a>
          <a href="#esports_cs2" class="domain-nav-item">电竞 CS2</a>
          <a href="#mechanical_keyboards" class="domain-nav-item">机械键盘</a>
          <a href="#gaming_mice" class="domain-nav-item">游戏鼠标</a>
          <a href="#keychron_official" class="domain-nav-item">Keychron 官号</a>
          <a href="#competitors" class="domain-nav-item">竞品</a>
          <a href="#sources" class="domain-nav-item">来源说明</a>
        </nav>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="dashboard-main">
      <!-- Hero / Header -->
      <section id="overview" class="dashboard-hero">
        <div class="hero-branding">
          <h1 class="brand-title">Keychron 情报台</h1>
          <p class="brand-subtitle">X 热搜仪表盘</p>
        </div>
        <div class="hero-meta">
          <div class="date-badge">2026-10-27</div>
          <div class="meta-info">{digest.ai_summary.as_of_sgt}</div>
        </div>
        <div class="hero-stats">
          <div class="stat-card">
            <div class="stat-value">{digest.counts.esports_cs2}</div>
            <div class="stat-label">CS2 电竞</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{digest.counts.mechanical_keyboards}</div>
            <div class="stat-label">机械键盘</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{digest.counts.gaming_mice}</div>
            <div class="stat-label">游戏鼠标</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{digest.counts.keychron_official}</div>
            <div class="stat-label">Keychron</div>
          </div>
          <div class="stat-card">
            <div class="stat-value">{digest.counts.competitors}</div>
            <div class="stat-label">竞品</div>
          </div>
        </div>
      </section>

      <!-- AI Summary (Green Box - First) -->
      <section id="ai-summary" class="ai-summary-section">
        <h2 class="section-heading">
          <span class="heading-icon">🤖</span> AI 阅读摘要
        </h2>
        <div class="ai-summary-box">
          <p class="summary-overall">{digest.ai_summary.overall}</p>
          
          <h3 class="summary-subheading">要点</h3>
          <ul class="summary-bullets">
            {digest.ai_summary.bullets.map(bullet => (
              <li>{bullet}</li>
            ))}
          </ul>
          
          {digest.ai_summary.shortfalls.length > 0 && (
            <>
              <h3 class="summary-subheading">缺口 / 注意</h3>
              <ul class="summary-shortfalls">
                {digest.ai_summary.shortfalls.map(shortfall => (
                  <li>{shortfall}</li>
                ))}
              </ul>
            </>
          )}
        </div>
      </section>

      <!-- Secondary Strip: Legacy Priority + Today's Matches -->
      <section class="secondary-strip">
        <div class="legacy-priority">
          <h3 class="strip-heading">
            <span class="sponsor-badge">赞助优先</span> Legacy 赛事战绩
          </h3>
          {legacyMatches.length > 0 ? (
            <div class="legacy-matches">
              {legacyMatches.slice(0, 2).map(match => (
                <div class="match-card">
                  <div class="match-title">{match.topic}</div>
                  <div class="match-meta">
                    <span class="match-engagement">{match.likes} ❤ · {Math.round(match.impressions / 1000)}k 曝光</span>
                  </div>
                  <div class="match-insight">{match.so_what}</div>
                  <a href={match.url} target="_blank" rel="noopener" class="match-link">查看详情 →</a>
                </div>
              ))}
            </div>
          ) : (
            <p class="no-matches">暂无 Legacy 赛事更新</p>
          )}
        </div>
      </section>

      <!-- Domain Rank Boards -->
      {Object.entries(digest.domains).map(([domainKey, items]) => (
        <section id={domainKey} class="domain-section">
          <h2 class="section-heading">
            <span class="domain-badge">{domainNames[domainKey]}</span>
            <span class="domain-count">{items.length} 条</span>
          </h2>
          
          <div class="rank-board">
            <div class="rank-header">
              <div class="rank-col-num">#</div>
              <div class="rank-col-topic">话题</div>
              <div class="rank-col-engagement">互动档</div>
            </div>
            {items.map(item => (
              <div class="rank-row">
                <div class="rank-col-num">
                  <span class="rank-number">{item.rank}</span>
                </div>
                <div class="rank-col-topic">
                  <a href={item.url} target="_blank" rel="noopener" class="topic-link">
                    {item.topic}
                  </a>
                  <div class="topic-meta">
                    <span class="topic-author">@{item.author_username}</span>
                    {item.so_what && (
                      <span class="topic-insight"> · {item.so_what}</span>
                    )}
                  </div>
                </div>
                <div class="rank-col-engagement">
                  <div class="engagement-stats">
                    <span class="stat-likes">{item.likes} ❤</span>
                    <span class="stat-impressions">{Math.round(item.impressions / 1000)}k 曝光</span>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Topic Details with Thumbnails (for items with images) -->
          {items.filter(item => item.thumb_url || (item.thumb_urls && item.thumb_urls.length > 0)).length > 0 && (
            <div class="topic-details">
              <h3 class="details-heading">本期话题详情</h3>
              <div class="topic-cards">
                {items.filter(item => item.thumb_url || (item.thumb_urls && item.thumb_urls.length > 0)).slice(0, 6).map(item => (
                  <div class="topic-card">
                    {(item.thumb_url || (item.thumb_urls && item.thumb_urls[0])) && (
                      <div class="topic-thumb">
                        <img 
                          src={item.thumb_url || item.thumb_urls[0]} 
                          alt={item.topic}
                          loading="lazy"
                        />
                      </div>
                    )}
                    <div class="topic-card-content">
                      <div class="topic-card-rank">#{item.rank}</div>
                      <h4 class="topic-card-title">
                        <a href={item.url} target="_blank" rel="noopener">
                          {item.topic}
                        </a>
                      </h4>
                      <div class="topic-card-stats">
                        {item.likes} ❤ · {Math.round(item.impressions / 1000)}k 曝光
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </section>
      ))}

      <!-- Footer: Sources -->
      <section id="sources" class="sources-section">
        <h2 class="section-heading">来源说明</h2>
        <div class="sources-box">
          <ul class="sources-list">
            <li><strong>Legacy</strong> = Keychron 已签赞助（@legacyggbr）</li>
            <li><strong>HLTV Top10</strong> 句柄：Spirit, Vitality, MOUZ, FURIA, Falcons, Aurora, Legacy, G2, FUT, NaVi</li>
            <li><strong>固定竞品</strong>：WootingKB, LogitechG, LogitechGesport, Razer, SteelSeries</li>
            <li><strong>官号</strong>：@KeychronMK（非 @keychron）</li>
            <li><strong>数据窗口</strong>：{digest.ai_summary.window}</li>
            <li><strong>蓝图</strong>：动态账号池 + 关键词池；域名为展示标签</li>
          </ul>
        </div>
      </section>
    </main>
  </div>

  <script>
    // Sticky navigation active state
    const observerOptions = {
      root: null,
      rootMargin: '-100px 0px -80% 0px',
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          document.querySelectorAll('.domain-nav-item').forEach(link => {
            link.classList.remove('active');
            if (link.getAttribute('href') === `#${id}`) {
              link.classList.add('active');
            }
          });
        }
      });
    }, observerOptions);

    document.querySelectorAll('section[id]').forEach(section => {
      observer.observe(section);
    });

    // Smooth scrolling
    document.querySelectorAll('.domain-nav-item').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('href').substring(1);
        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  </script>
</BaseLayout>
