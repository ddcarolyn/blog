---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import CategoryPill from '../../components/CategoryPill.astro';
import PostCard from '../../components/PostCard.astro';
import { coverSources, fmtDate, getPublishedPosts, SITE, tagUrl } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const cover = coverSources(post);
/** 文末「相关」:同专栏优先,不够补最新;带封面放文末(Lenfest 实验:带图 +63%、文末 +55%) */
const all = (await getPublishedPosts()).filter((p) => p.slug !== post.slug);
const related = [
  ...all.filter((p) => p.data.category === post.data.category),
  ...all.filter((p) => p.data.category !== post.data.category),
].slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  image={post.data.cover}
  wide
>
  <div class="layout-with-sidebar">
    <div>
      <article class="visual-article">
        <header class="article-header">
          {post.data.category && <p class="article-category"><CategoryPill slug={post.data.category} /></p>}
          <h1 class="article-title">{post.data.title}</h1>
          <div class="article-meta">
            <span>{SITE.author} · {fmtDate(post.data.date)}</span>
            {
              post.data.tags.length > 0 && (
                <span class="article-tags">
                  {' · '}
                  {post.data.tags.map((t, i) => (
                    <>
                      {i > 0 && ' '}
                      <a href={tagUrl(t)}>#{t}</a>
                    </>
                  ))}
                </span>
              )
            }
          </div>
        </header>
        {
          post.data.cover && (
            <figure class="article-cover">
              <img
                src={cover.mid}
                srcset={cover.srcset}
                sizes="(max-width: 960px) 100vw, 800px"
                alt=""
                width="1536"
                height="864"
                fetchpriority="high"
              />
            </figure>
          )
        }
        <div class="article-body">
          <Content />
        </div>
        {
          related.length > 0 && (
            <aside class="related" aria-label="相关文章">
              <h2>接着读</h2>
              <div class="related-grid">
                {related.map((p) => <PostCard post={p} />)}
              </div>
              <p class="related-sub">
                新文章不定期,用 <a href="/rss.xml">RSS</a> 追,或者 <a href={`mailto:${SITE.email}`}>写邮件</a>聊聊。 <a href="/#columns">看全部专栏 →</a>
              </p>
            </aside>
          )
        }
      </article>
    </div>

    <Sidebar currentSlug={post.slug} />
  </div>
</BaseLayout>
