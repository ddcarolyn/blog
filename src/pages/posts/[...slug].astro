---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { fmtDate, getPublishedPosts, SITE, tagUrl } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  wide
>
  <div class="layout-with-sidebar">
    <div>
      <article class="visual-article">
        <header class="article-header">
          <h1 class="article-title">{post.data.title}</h1>
          <div class="article-meta">
            <span>{SITE.author} · {fmtDate(post.data.date)}</span>
            {
              post.data.tags.length > 0 && (
                <span class="article-tags">
                  {' · '}
                  {post.data.tags.map((t, i) => (
                    <>
                      {i > 0 && ' '}
                      <a href={tagUrl(t)}>#{t}</a>
                    </>
                  ))}
                </span>
              )
            }
          </div>
        </header>
        <div class="article-body">
          <Content />
        </div>
        <p class="article-back"><a href="/">← 回到首页</a></p>
      </article>
    </div>

    <Sidebar currentSlug={post.slug} />
  </div>
</BaseLayout>
