---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryTabs from '../../components/CategoryTabs.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES } from '../../lib/categories';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category, posts: posts.filter((p) => p.data.category === category.slug) },
  })).filter((x) => x.props.posts.length > 0);
}

const { category, posts } = Astro.props;
---

<BaseLayout
  title={category.name}
  description={`${category.blurb} ddcarolyn「${category.name}」专栏,共 ${posts.length} 篇。`}
  image={posts[0]?.data.cover}
  active="columns"
  wide
>
  <div class="home columns-page">
    <CategoryTabs active={category.slug} />
    <section class="col-section" style={`--cat:${category.accent};--cat-dark:${category.accentDark}`}>
      <header class="col-head">
        <h1>{category.name} <span class="cat-en">{category.en}</span></h1>
        <p class="col-blurb">{category.blurb} · {posts.length} 篇</p>
      </header>
      <div class="index-grid">
        {posts.map((p, i) => <PostCard post={p} eager={i < 4} />)}
      </div>
    </section>
  </div>
</BaseLayout>
