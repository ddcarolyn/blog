---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, postUrl } from '../lib/posts';

const posts = await getPublishedPosts();

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const mdDay = (d: Date) =>
  `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(
    2,
    '0'
  )}`;
---

<BaseLayout title="归档" active="archive">
  <h1 class="article-title">归档</h1>
  <p class="muted">共 {posts.length} 篇</p>
  {
    posts.length === 0 ? (
      <p class="empty">暂无归档</p>
    ) : (
      years.map((y) => (
        <section>
          <h2 class="archive-year">{y}</h2>
          <ul class="archive-list">
            {byYear.get(y)!.map((p) => (
              <li class="archive-item">
                <span class="archive-date">{mdDay(p.data.date)}</span>
                <a href={postUrl(p)}>{p.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</BaseLayout>
