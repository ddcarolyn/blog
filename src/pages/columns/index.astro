---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryTabs from '../../components/CategoryTabs.astro';
import ColumnSection from '../../components/ColumnSection.astro';
import { getPublishedPosts, postsByCategory } from '../../lib/posts';

const posts = await getPublishedPosts();
const groups = postsByCategory(posts);
---

<BaseLayout title="专栏" active="columns" description="ddcarolyn 全部专栏:出海实战、AI 工作流、建站手记、学习提升、书架。" wide>
  <div class="home columns-page">
    <CategoryTabs active="all" />
    <ColumnSection title="最新" posts={posts} limit={4} eager />
    {groups.map((g) => <ColumnSection category={g.category} posts={g.posts} />)}
  </div>
</BaseLayout>
