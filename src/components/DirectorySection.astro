---
/** 首页目录:一个专栏一块,只列标题 + 日期 + 一句描述,不放封面,别抢信的风头。 */
import { categoryUrl, type Category } from '../lib/categories';
import { fmtDate, postUrl, type Post } from '../lib/posts';

interface Props {
  category: Category;
  posts: Post[];
}
const { category, posts } = Astro.props;
---

<section class="dir-section" style={`--cat:${category.accent};--cat-dark:${category.accentDark}`}>
  <header class="dir-head">
    <h3><a href={categoryUrl(category)}>{category.name}</a> <span class="cat-en">{category.en}</span></h3>
    <p>{category.blurb}</p>
  </header>
  <ol class="dir-list">
    {
      posts.map((p) => (
        <li>
          <a href={postUrl(p)}>
            <span class="dir-title">{p.data.title}</span>
            {p.data.description && <span class="dir-desc">{p.data.description}</span>}
            <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
          </a>
        </li>
      ))
    }
  </ol>
</section>
