---
/** 专栏页的一个区块:标题行 + 卡片网格,区块之间靠分割线分开 */
import PostCard from './PostCard.astro';
import { categoryUrl, type Category } from '../lib/categories';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
  category?: Category;
  /** 没有 category 时的标题(如「最新」) */
  title?: string;
  limit?: number;
  eager?: boolean;
}
const { posts, category, title, limit = 8, eager = false } = Astro.props;
const shown = posts.slice(0, limit);
const style = category ? `--cat:${category.accent};--cat-dark:${category.accentDark}` : undefined;
---

<section class="col-section" style={style} id={category?.slug}>
  <header class="col-head">
    <h2>
      {category ? <a href={categoryUrl(category)}>{category.name}</a> : title}
      {category && <span class="cat-en">{category.en}</span>}
    </h2>
    {category && <p class="col-blurb">{category.blurb}</p>}
    {category && posts.length > limit && <a class="col-more" href={categoryUrl(category)}>全部 {posts.length} 篇 →</a>}
  </header>
  <div class="index-grid">
    {shown.map((p, i) => <PostCard post={p} eager={eager && i < 4} />)}
  </div>
</section>
