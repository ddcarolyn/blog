---
/** 首页索引:tab + 全部文章卡片网格(16:10、两行标题、灰 chip),不分栏 */
import CategoryTabs from './CategoryTabs.astro';
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<section class="index" aria-label="全部文章">
  <CategoryTabs active="all" />
  <div class="index-grid">
    {posts.map((p, i) => <PostCard post={p} eager={i < 4} />)}
  </div>
</section>
