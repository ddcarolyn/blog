---
import { coverThumbUrl, coverUrl, postUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const full = coverUrl(post);
const thumb = coverThumbUrl(post);
---

<li>
  <a class="home-row" href={postUrl(post)}>
    <img
      src={thumb}
      srcset={thumb !== full ? `${thumb} 376w, ${full} 1536w` : undefined}
      sizes={thumb !== full ? '(max-width: 600px) 92px, 188px' : undefined}
      alt=""
      loading="lazy"
      decoding="async"
      width="188"
      height="106"
    />
    <span class="home-row-copy">
      <h3>{post.data.title}</h3>
      {post.data.description && <p>{post.data.description}</p>}
    </span>
  </a>
</li>
