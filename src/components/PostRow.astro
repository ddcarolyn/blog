---
import { coverSources, postUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
  /** 列表里的序号：前几行在首屏，封面不要懒加载，手机上才能跟着 HTML 一起出来 */
  index?: number;
}
const { post, index = 99 } = Astro.props;
const eager = index < 3;
const cover = coverSources(post);
---

<li>
  <a class="home-row" href={postUrl(post)}>
    <img
      src={cover.thumb}
      srcset={cover.srcset}
      sizes="(max-width: 600px) 92px, 188px"
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager && index === 0 ? 'high' : undefined}
      decoding="async"
      width="188"
      height="106"
    />
    <span class="home-row-copy">
      <h3>{post.data.title}</h3>
      {post.data.description && <p>{post.data.description}</p>}
    </span>
  </a>
</li>
