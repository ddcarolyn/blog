---
/** S2 信带:字直接写在图里(图的右侧是主体,左侧留白给字),没有标题、没有展开。 */
import { LETTER_BAND } from '../lib/letter';
interface Props {
  /** 21:9 底图,主体在右 35–40% */
  img: string;
  /** 'a' 卡通暖色 / 'b' 小清新冷色,只影响字色 */
  tone?: 'a' | 'b';
}
const { img, tone = 'b' } = Astro.props;
---

<section class={`letter-band tone-${tone}`} aria-label="给来到这里的你" style={`--band-img:url('${img}')`}>
  <div class="band-text">
    {LETTER_BAND.map((l) => <p>{l}</p>)}
    <p class="band-foot">Carolyn · <a href="/letter/">整封信 →</a> · <a href="/rss.xml">新文用 RSS 追 →</a></p>
  </div>
</section>
